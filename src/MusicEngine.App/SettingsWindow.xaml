<Window x:Class="MusicEngine.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="640" SizeToContent="Height" MaxHeight="780"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20">

            <TextBlock Text="Settings" FontSize="18" FontWeight="Bold"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Most changes apply instantly; proxy &amp; tool paths need a restart."
                       FontSize="11.5" Foreground="{StaticResource FaintTextBrush}" Margin="0,0,0,18"/>

            <!-- ═══ general ═══ -->
            <TextBlock Text="GENERAL" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" Margin="0,0,0,8"/>

            <TextBlock Text="Music folder" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,5"/>
            <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Browse…" Style="{StaticResource Btn}" Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}"/>
                <TextBox Style="{StaticResource Input}"
                         Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Filename template" Foreground="{StaticResource SubtleTextBrush}"/>
                    <ComboBox Style="{StaticResource Combo}" Margin="0,5,10,0" Width="230"
                              HorizontalAlignment="Left"
                              ItemsSource="{Binding FilenameTemplateLabels}"
                              SelectedIndex="{Binding FilenameTemplateIndex, Mode=TwoWay}"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="MP3 bitrate (yt-dlp conversion)" Foreground="{StaticResource SubtleTextBrush}"/>
                    <ComboBox Style="{StaticResource Combo}" Margin="0,5,0,0" Width="110"
                              HorizontalAlignment="Right"
                              ItemsSource="{Binding BitrateLabels}"
                              SelectedIndex="{Binding BitrateIndex, Mode=TwoWay}"/>
                </StackPanel>
            </Grid>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <CheckBox Grid.Column="0" Style="{StaticResource Switch}"
                          Content="Toast when a download finishes" FontSize="12"
                          IsChecked="{Binding DownloadToasts, Mode=TwoWay}"/>
                <CheckBox Grid.Column="1" Style="{StaticResource Switch}"
                          Content="Stay in tray while downloads run" FontSize="12"
                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}"/>
            </Grid>
            <CheckBox Style="{StaticResource Switch}" Margin="0,0,0,4"
                      Content="Watch clipboard for Spotify / YouTube links" FontSize="12"
                      IsChecked="{Binding ClipboardMonitor, Mode=TwoWay}"/>

            <!-- accent -->
            <TextBlock Text="Accent color" Foreground="{StaticResource SubtleTextBrush}" Margin="0,12,0,6"/>
            <ItemsControl ItemsSource="{Binding Accents}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Width="30" Height="30" Margin="0,0,10,0" Cursor="Hand"
                                ToolTip="{Binding Label}"
                                Command="{Binding DataContext.SelectAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border CornerRadius="15"
                                            Background="{Binding Hex, Converter={StaticResource HexToBrush}}"
                                            BorderBrush="White" BorderThickness="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BorderThickness" Value="2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="✓" Foreground="Black" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ═══ sources ═══ -->
            <TextBlock Text="SEARCH SOURCES" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" Margin="0,18,0,8"/>
            <TextBlock Text="Disabled sources are skipped in search AND download ranking."
                       FontSize="11" Foreground="{StaticResource FaintTextBrush}" Margin="0,0,0,8"/>
            <ItemsControl ItemsSource="{Binding Sources}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Style="{StaticResource Switch}" FontSize="12" Margin="0,0,22,10"
                                  Content="{Binding DisplayName}"
                                  IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox Style="{StaticResource Switch}" Margin="0,2,0,0"
                      Content="Persian Index sidecar (Python + curl_cffi)" FontSize="12"
                      IsChecked="{Binding EnablePersianIndex, Mode=TwoWay}"/>

            <!-- ═══ network ═══ -->
            <TextBlock Text="NETWORK" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" Margin="0,18,0,8"/>

            <TextBlock Text="Proxy (SOCKS5/HTTP) — used for YouTube, Deezer, SoundCloud &amp; yt-dlp. Empty = direct."
                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,5" TextWrapping="Wrap"/>
            <TextBox Style="{StaticResource Input}" Margin="0,0,0,14"
                     Text="{Binding ProxyUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="Browser for YouTube cookies (chrome, firefox, edge…) — helps with bot checks. Empty = none."
                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,5" TextWrapping="Wrap"/>
            <TextBox Style="{StaticResource Input}" Margin="0,0,0,10"
                     Text="{Binding CookiesBrowser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <TextBlock Text="cookies.txt file (exported via a browser extension) — works even while the browser is open."
                       Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,5" TextWrapping="Wrap"/>
            <TextBox Style="{StaticResource Input}" Margin="0,0,0,14"
                     Text="{Binding CookiesFile, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

            <!-- ═══ performance ═══ -->
            <TextBlock Text="PERFORMANCE" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                       FontWeight="SemiBold" Margin="0,18,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <TextBlock Text="Parallel downloads" Foreground="{StaticResource SubtleTextBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ComboBox Style="{StaticResource Combo}" Width="90"
                          ItemsSource="{Binding ParallelOptions}"
                          SelectedItem="{Binding MaxParallelDownloads, Mode=TwoWay}"/>
                <TextBlock Text="Direct MP3s use 4-segment parallel transfer automatically."
                           FontSize="11" Foreground="{StaticResource FaintTextBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0"/>
            </StackPanel>

            <!-- FEAT-01/04: file logs + crash log paths are the support contract;
                 the diagnostics bundle is the copy-paste report. -->
            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                <Button Content="Open logs folder" Style="{StaticResource BtnGhost}" FontSize="11.5"
                        Command="{Binding OpenLogsFolderCommand}"/>
                <Button Content="Open crash log" Style="{StaticResource BtnGhost}" FontSize="11.5" Margin="8,0,0,0"
                        Command="{Binding OpenCrashLogCommand}"/>
                <Button Content="Copy diagnostics" Style="{StaticResource BtnGhost}" FontSize="11.5" Margin="8,0,0,0"
                        Command="{Binding CopyDiagnosticsCommand}"/>
                <TextBlock Text="{Binding DiagnosticsNotice}" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Cancel" Style="{StaticResource Btn}" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button Content="Save" Style="{StaticResource BtnAccent}" Click="Save_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
