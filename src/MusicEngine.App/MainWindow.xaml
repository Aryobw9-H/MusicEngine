<Window x:Class="MusicEngine.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MusicEngine.App"
        xmlns:vm="clr-namespace:MusicEngine.App.ViewModels"
        Title="MusicEngine" Height="760" Width="1120" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        Closing="Window_Closing">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolToVisibility x:Key="InverseBoolToVis"/>
        <local:StringToVisibility x:Key="StringToVis"/>

        <!-- entrance animation for result cards -->
        <Storyboard x:Key="CardIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.Y)"
                             From="10" To="0" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- toast entrance -->
        <Storyboard x:Key="ToastIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
            <DoubleAnimation Storyboard.TargetProperty="(RenderTransform).(TranslateTransform.X)"
                             From="40" To="0" Duration="0:0:0.22">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="D" Command="{Binding DownloadSelectedCommand}"/>
        <KeyBinding Modifiers="Control+Shift" Key="D" Command="{Binding DownloadAllCommand}"/>
        <KeyBinding Key="Esc" Command="{Binding StopPreviewCommand}"/>
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230" MinHeight="120" MaxHeight="420"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════ header ═══════════ -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" Padding="20,13"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,18,0">
                    <Border Background="{DynamicResource AccentBrush}" CornerRadius="8" Width="30" Height="30"
                            VerticalAlignment="Center">
                        <TextBlock Text="♪" FontSize="17" Foreground="#0B0E12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock Text="MusicEngine" FontSize="17" FontWeight="Bold" Margin="10,0,0,0"
                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- search -->
                <Grid Grid.Column="1" Margin="0,0,14,0" x:Name="SearchGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Column="0" Style="{StaticResource Input}"
                             Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="SearchBox_KeyDown"/>
                    <TextBlock Grid.Column="0" Text="Search any song — tataloo behesht ، تتلو بهشت ، or paste a link"
                               Foreground="{StaticResource FaintTextBrush}" FontSize="13.5"
                               VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding Query, Converter={StaticResource StringToVis}, ConverterParameter=inverse}"/>
                    <Button x:Name="RecentsBtn" Grid.Column="1" Style="{StaticResource BtnGhost}" Content="⏷"
                            FontSize="12" Margin="4,0,0,0" Click="Recents_Click" ToolTip="Recent searches"/>
                    <Button x:Name="ClearQueryBtn" Grid.Column="2" Style="{StaticResource BtnGhost}" Content="✕"
                            FontSize="12" Margin="2,0,4,0" Click="ClearQuery_Click" ToolTip="Clear"
                            Visibility="{Binding Query, Converter={StaticResource StringToVis}}"/>
                    <Button Grid.Column="3" Content="Search" Style="{StaticResource BtnAccent}" Click="Search_Click"/>

                    <Popup x:Name="RecentsPopup" PlacementTarget="{Binding ElementName=SearchBox}" Placement="Bottom"
                           AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade">
                        <Border Background="{StaticResource PanelBrush}" CornerRadius="10"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Margin="0,5,0,0"
                                MinWidth="280" MaxWidth="460" Padding="6">
                            <StackPanel>
                                <TextBlock Text="Recent searches" FontSize="11"
                                           Foreground="{StaticResource FaintTextBrush}" Margin="8,6,8,4"/>
                                <ItemsControl ItemsSource="{Binding RecentSearches}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BtnGhost}" HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left" Padding="8,7"
                                                    Click="Recent_Click">
                                                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="⚙  Settings" Style="{StaticResource Btn}" Command="{Binding OpenSettingsCommand}"/>
                    <Button Content="📂  Music folder" Style="{StaticResource Btn}" Margin="8,0,0,0"
                            Command="{Binding OpenFolderCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- search progress line -->
        <Border Grid.Row="0" VerticalAlignment="Bottom" Height="2" Background="Transparent">
            <ProgressBar x:Name="SearchSpinner" IsIndeterminate="True" Height="2"
                         Foreground="{DynamicResource AccentBrush}" Background="Transparent"
                         BorderThickness="0" Visibility="Collapsed"/>
        </Border>

        <!-- ═══════════ results ═══════════ -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- clipboard pill -->
            <Border Grid.Row="0" x:Name="ClipboardPill" Background="{StaticResource CardBrush}"
                    CornerRadius="9" Padding="12,8" Margin="14,10,14,0"
                    Visibility="{Binding ClipboardPill, Converter={StaticResource StringToVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔗" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Music link copied to clipboard" VerticalAlignment="Center"
                               Foreground="{StaticResource SubtleTextBrush}" FontSize="12.5"/>
                    <TextBlock Text="{Binding ClipboardPill}" VerticalAlignment="Center" Margin="10,0,0,0"
                               Foreground="{DynamicResource AccentBrush}" FontSize="12.5"
                               TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                    <Button Content="Search it" Style="{StaticResource BtnAccent}" Margin="14,0,0,0" Padding="10,4"
                            Command="{Binding SearchClipboardCommand}"/>
                    <Button Content="✕" Style="{StaticResource BtnGhost}" Margin="6,0,0,0"
                            Command="{Binding DismissClipboardCommand}"/>
                </StackPanel>
            </Border>

            <!-- toolbar -->
            <Grid Grid.Row="0" Margin="16,10,16,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}" Text="Results"/>
                    <TextBlock x:Name="ResultsCount" Text="" Margin="8,0,0,0" FontSize="12.5"
                               Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <ComboBox Grid.Column="1" Style="{StaticResource Combo}" Margin="16,0,0,0" Width="120"
                          SelectedIndex="0" SelectionChanged="Sort_SelectionChanged" ToolTip="Sort results">
                    <ComboBoxItem Content="Relevance"/>
                    <ComboBoxItem Content="Duration"/>
                    <ComboBoxItem Content="Title"/>
                </ComboBox>
                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <CheckBox Style="{StaticResource Switch}" Content="Hide in library" FontSize="12"
                              Foreground="{StaticResource SubtleTextBrush}"
                              IsChecked="{Binding HideInLibrary, Mode=TwoWay}"/>
                    <Button Content="⬇  Download all" Style="{StaticResource Btn}" Margin="14,0,0,0"
                            Command="{Binding DownloadAllCommand}"/>
                </StackPanel>
            </Grid>

            <ListBox Grid.Row="1" x:Name="ResultsList" ItemsSource="{Binding ResultsView}"
                     Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Padding="14,6,14,10"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     PreviewKeyDown="ResultsList_PreviewKeyDown"
                     MouseDoubleClick="ResultsList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="12">
                                        <ContentPresenter x:Name="Presenter" Opacity="1" RenderTransformOrigin="0,0">
                                            <ContentPresenter.RenderTransform>
                                                <TranslateTransform X="0" Y="0"/>
                                            </ContentPresenter.RenderTransform>
                                        </ContentPresenter>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#232B36"/>
                                        </Trigger>
                                        <EventTrigger RoutedEvent="Loaded">
                                            <BeginStoryboard Storyboard="{StaticResource CardIn}"/>
                                        </EventTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:TrackItemViewModel}">
                        <DataTemplate.Resources>
                            <Storyboard x:Key="EqLoop" RepeatBehavior="Forever" AutoReverse="True">
                                <DoubleAnimation Storyboard.TargetName="EqA" Storyboard.TargetProperty="Height"
                                                 To="16" Duration="0:0:0.4"/>
                                <DoubleAnimation Storyboard.TargetName="EqB" Storyboard.TargetProperty="Height"
                                                 To="22" Duration="0:0:0.5"/>
                                <DoubleAnimation Storyboard.TargetName="EqC" Storyboard.TargetProperty="Height"
                                                 To="13" Duration="0:0:0.33"/>
                            </Storyboard>
                        </DataTemplate.Resources>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- artwork + overlays -->
                                <Grid Grid.Column="0" Width="64" Height="64" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <Border Width="64" Height="64" CornerRadius="10">
                                        <Border.OpacityMask>
                                            <VisualBrush>
                                                <VisualBrush.Visual>
                                                    <Border Background="Black" CornerRadius="10" Width="64" Height="64"/>
                                                </VisualBrush.Visual>
                                            </VisualBrush>
                                        </Border.OpacityMask>
                                        <Grid>
                                            <TextBlock Text="♪" FontSize="26" Foreground="{StaticResource FaintTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Source="{Binding Artwork}" Width="64" Height="64" Stretch="UniformToFill"/>
                                        </Grid>
                                    </Border>
                                    <!-- duration pill -->
                                    <Border Background="#A0000000" CornerRadius="5" Padding="5,1"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,4,4">
                                        <TextBlock Text="{Binding Duration}" FontSize="10.5" Foreground="#E8EAF0"/>
                                    </Border>
                                    <!-- preview overlay -->
                                    <Button x:Name="PreviewBtn" Width="64" Height="64" Opacity="0"
                                            Background="#66000000" BorderThickness="0" Cursor="Hand"
                                            Click="Preview_Click" IsEnabled="{Binding HasPreview}" ToolTip="Preview 30s">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="#66000000" CornerRadius="10">
                                                    <TextBlock Text="▶" FontSize="20" Foreground="White"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <!-- equalizer when playing -->
                                    <StackPanel x:Name="Eq" Orientation="Horizontal" Visibility="Collapsed"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="#88000000">
                                        <Rectangle x:Name="EqA" Width="4" Height="8" Fill="White" RadiusX="2" RadiusY="2" Margin="1"/>
                                        <Rectangle x:Name="EqB" Width="4" Height="14" Fill="White" RadiusX="2" RadiusY="2" Margin="1"/>
                                        <Rectangle x:Name="EqC" Width="4" Height="10" Fill="White" RadiusX="2" RadiusY="2" Margin="1"/>
                                    </StackPanel>
                                </Grid>

                                <!-- text -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}"/>
                                    <TextBlock Text="{Binding Artist}" FontSize="12.5" Margin="0,3,0,0"
                                               Foreground="{StaticResource SubtleTextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource Chip}">
                                            <TextBlock Text="{Binding SourcesLabel}" FontSize="10.5" Foreground="#7BD99A"/>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="#262A38" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding QualityLabel}" FontSize="10.5"
                                                       Foreground="{StaticResource SubtleTextBrush}"/>
                                        </Border>
                                        <Border Style="{StaticResource Chip}" Background="#1E3A2A" Margin="6,0,0,0"
                                                Visibility="{Binding LibraryBadge, Converter={StaticResource StringToVis}}">
                                            <TextBlock Text="{Binding LibraryBadge}" FontSize="10.5" Foreground="#7BD99A"/>
                                        </Border>
                                        <TextBlock Text="{Binding Album}" FontSize="11" Margin="8,0,0,0"
                                                   Foreground="{StaticResource FaintTextBrush}"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="280" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- actions -->
                                <Button Grid.Column="2" Style="{StaticResource BtnAccent}" Content="⬇  Download"
                                        Click="Download_Click" Cursor="Hand" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsPreviewPlaying}" Value="True">
                                <Setter TargetName="Eq" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="PreviewBtn" Property="Visibility" Value="Collapsed"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard x:Name="EqBegin" Storyboard="{StaticResource EqLoop}"/>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <RemoveStoryboard BeginStoryboardName="EqBegin"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <Trigger SourceName="PreviewBtn" Property="IsMouseOver" Value="True">
                                <Setter TargetName="PreviewBtn" Property="Opacity" Value="1"/>
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- empty state -->
            <StackPanel Grid.Row="1" x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="🎧" FontSize="54" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                <TextBlock Text="Search any song — Finglish, Persian, or a Spotify / YouTube link"
                           FontSize="15" Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="tataloo behesht    •    تتلو بهشت    •    coldplay yellow"
                           FontSize="12.5" Margin="0,9,0,0" Foreground="{StaticResource FaintTextBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Enter = search     Space = preview     Enter on a row = download     Ctrl+D = download top"
                           FontSize="11" Margin="0,18,0,0" Foreground="{StaticResource FaintTextBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="Transparent"
                      ShowsPreview="False"/>

        <!-- ═══════════ downloads / history ═══════════ -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="16,10,16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="TabDownloads" Style="{StaticResource BtnAccent}" Content="Downloads"
                                Padding="12,5" FontSize="12" Click="TabDownloads_Click"/>
                        <Button x:Name="TabHistory" Style="{StaticResource Btn}" Content="History"
                                Padding="12,5" FontSize="12" Margin="8,0,0,0" Click="TabHistory_Click"/>
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="9" MinWidth="22" Height="18"
                                Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding ShowDownloads, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding ActiveDownloads}" FontSize="11" Foreground="#0B0E12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding OutputDirectory, StringFormat=📂 {0}}" FontSize="11"
                                   Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center"
                                   Margin="0,0,12,0" TextTrimming="CharacterEllipsis" MaxWidth="380"
                                   ToolTip="{Binding OutputDirectory}"/>
                        <Button Content="Clear finished" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                Command="{Binding ClearFinishedCommand}" Margin="0,0,6,0"
                                Visibility="{Binding ShowDownloads, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Cancel all" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                Click="CancelAll_Click" Margin="0,0,6,0"
                                Visibility="{Binding ShowDownloads, Converter={StaticResource BoolToVis}}"/>
                        <Button Content="Clear" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                Command="{Binding ClearHistoryCommand}"
                                Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>

                <!-- downloads list -->
                <ListBox Grid.Row="1" ItemsSource="{Binding DownloadQueue}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         Visibility="{Binding ShowDownloads, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DownloadItemViewModel}">
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                        <Border Style="{StaticResource Chip}" Background="#262A38" Padding="5,1">
                                            <TextBlock Text="{Binding Provider}" FontSize="9.5"
                                                       Foreground="{StaticResource SubtleTextBrush}"/>
                                        </Border>
                                        <TextBlock Text="{Binding SizeText}" FontSize="10.5" Margin="7,0,0,0"
                                                   Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SpeedText}" FontSize="10.5" Margin="7,0,0,0"
                                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EtaText}" FontSize="10.5" Margin="7,0,0,0"
                                                   Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource SlimProgress}" Width="190"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 IsIndeterminate="{Binding IsIndeterminate}"
                                                 HorizontalAlignment="Left"/>
                                </Grid>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="11.5" MinWidth="170"
                                           Foreground="{Binding IsFailed, Converter={StaticResource BoolToRed}}"
                                           VerticalAlignment="Center" Margin="0,0,10,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Button Content="Open" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                                                            Click="OpenDownload_Click" Margin="0,0,4,0" ToolTip="Play the file"
                                                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}"/>
                                                                    <Button Content="📁" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                                                            Click="OpenDownloadFolder_Click" Margin="0,0,4,0" ToolTip="Show in folder"
                                                                            Visibility="{Binding IsFinished, Converter={StaticResource BoolToVis}}"/>
                                                                    <Button Content="⏸" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                                                            Command="{Binding DataContext.PauseDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Margin="0,0,4,0" ToolTip="Pause"
                                                                            Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                                                    <Button Content="▶" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                                                            Command="{Binding DataContext.ResumeDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Margin="0,0,4,0" ToolTip="Resume"
                                                                            Visibility="{Binding IsPaused, Converter={StaticResource BoolToVis}}"/>
                                                                    <Button Content="↻" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                                                            Command="{Binding DataContext.RestartDownloadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}" Margin="0,0,4,0" ToolTip="Restart download"
                                                                            Visibility="{Binding IsFailed, Converter={StaticResource BoolToVis}}"/>
                                                                    <Button Content="✕" Style="{StaticResource BtnGhost}" FontSize="11.5"
                                                                            Click="CancelDownload_Click" ToolTip="Cancel / remove"/>
                                                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- history list -->
                <ListBox Grid.Row="1" ItemsSource="{Binding History}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Visibility="{Binding ShowHistory, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Display}" FontSize="12.5"
                                           Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <Border Grid.Column="1" Style="{StaticResource Chip}" Background="#262A38" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding Provider}" FontSize="9.5"
                                               Foreground="{StaticResource SubtleTextBrush}"/>
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding When}" FontSize="11"
                                           Foreground="{StaticResource FaintTextBrush}" VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>
                                <Button Grid.Column="3" Content="▶" Style="{StaticResource BtnGhost}" FontSize="12"
                                        Click="OpenHistoryItem_Click" ToolTip="Play"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- ═══════════ now playing bar ═══════════ -->
        <Border Grid.Row="4" Background="{StaticResource CardDeepBrush}" Padding="16,9"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding IsPreviewPlaying, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="7" Margin="0,0,12,0">
                    <Grid>
                        <TextBlock Text="♪" FontSize="17" Foreground="{StaticResource FaintTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image Source="{Binding PlayerArtwork}" Stretch="UniformToFill"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock Text="{Binding PlayerTitle}" FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding PlayerArtist}" FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" MinWidth="260">
                    <TextBlock Text="🔈" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Slider Style="{StaticResource Slider}" Width="80" Minimum="0" Maximum="100"
                            Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"
                            ToolTip="Volume"/>
                    <TextBlock x:Name="PlayerTimeText" Text="{Binding PlayerTime}" FontSize="11"
                               Foreground="{StaticResource SubtleTextBrush}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Slider x:Name="SeekSlider" Style="{StaticResource Slider}" Width="240" Minimum="0"
                            VerticalAlignment="Center" Thumb.DragStarted="Seek_DragStarted"
                            Thumb.DragCompleted="Seek_DragCompleted"/>
                </StackPanel>

                <Button Grid.Column="3" Content="⏹" Style="{StaticResource Btn}" FontSize="13" Padding="10,5"
                        Command="{Binding StopPreviewCommand}" Margin="12,0,0,0" ToolTip="Stop preview (Esc)"/>
            </Grid>
        </Border>

        <!-- ═══════════ status bar ═══════════ -->
        <Border Grid.Row="5" Background="{StaticResource PanelBrush}" Padding="20,6"
                BorderBrush="{StaticResource BorderSoftBrush}" BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock Text="{Binding Status}" FontSize="11.5" Foreground="{StaticResource SubtleTextBrush}"
                           HorizontalAlignment="Left" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="MusicEngine v2 • downloads run in a tray-friendly background"
                           FontSize="10.5" Foreground="{StaticResource FaintTextBrush}" HorizontalAlignment="Right"/>
            </Grid>
        </Border>

        <!-- ═══════════ toasts ═══════════ -->
        <ItemsControl Grid.Row="0" Grid.RowSpan="6" ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,18,0"
                      IsHitTestVisible="True" Panel.ZIndex="100">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:ToastViewModel}">
                    <Border Background="#EE1E2230" CornerRadius="11" Padding="14,10" Margin="0,0,0,10"
                            MinWidth="250" MaxWidth="360" Cursor="Hand" MouseLeftButtonUp="Toast_Click"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard Storyboard="{StaticResource ToastIn}"/>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{Binding IsError, Converter={StaticResource BoolToRed}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Message}" FontSize="11.5" Margin="0,3,0,0"
                                       Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
